{
  "name": "eco-crafter-toolkit",
  "version": "0.4.0",
  "dependencies": {
    "@sentry/react": "^10.55.0",
    "@xyflow/react": "^12.10.2",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "tinybase": "^8.4.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "adm-zip": "^0.5.17",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "sharp": "^0.34.5",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "yargs": "^18.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fullcheck": "aube run lint && aube run knip && aube run typecheck && aube run format && aube run test:coverage",
    "knip": "knip",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:dot": "vitest run --reporter=dot",
    "typecheck": "tsc --noEmit"
  },
  "aube": {
    "overrides": {
      "axios": "1.15.2"
    },
    "allowBuilds": {
      "esbuild": true,
      "sharp": true,
      "@sentry/cli": true
    }
  },
  "license": "MIT",
  "private": true
}
