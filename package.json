    "tinybase": "^8.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@crowdin/crowdin-api-client": "^1.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "knip": "^6.12.2",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "yargs": "^18.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fullcheck": "aube run lint && aube run knip && aube run typecheck && aube run format && aube run test:coverage",
    "knip": "knip",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "aube": {
    "overrides": {
      "axios": "1.15.1"
    },
    "allowBuilds": {
      "esbuild": true,
      "sharp": true
    }
  },
  "license": "MIT",
  "private": true
