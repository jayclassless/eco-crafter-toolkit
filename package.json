    "rxjs": "^7.8.2",
    "tinybase": "^8.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@crowdin/crowdin-api-client": "^1.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
