{
  "name": "eco-crafter-toolkit",
  "version": "0.9.0",
  "type": "module",
  "dependencies": {
    "@sentry/react": "^10.71.0",
    "@xyflow/react": "^12.11.5",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "tinybase": "^9.5.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "adm-zip": "^0.6.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "knip": "^6.32.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "sharp": "^0.34.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yargs": "^18.1.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fullcheck": "aube run lint && aube run knip && aube run typecheck && aube run format && aube run test:coverage",
    "knip": "knip",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:dot": "vitest run --reporter=dot",
    "typecheck": "tsc --noEmit"
  },
  "aube": {
    "overrides": {
      "axios": "1.15.2"
    },
    "allowBuilds": {
      "esbuild": true,
      "sharp": true,
      "@sentry/cli": true
    }
  },
  "license": "MIT",
  "private": true
}
